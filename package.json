{
  "name": "ali-d-coded",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "cross-env NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "cross-env NODE_ENV=test remix test",
    "content:export": "cross-env NODE_ENV=production node --import remix/node-tsx scripts/content.ts export",
    "content:import": "cross-env NODE_ENV=production node --import remix/node-tsx scripts/content.ts import",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "remix": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
