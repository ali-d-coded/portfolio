# Copy to .env for local development.
PORT=3300
# Turns the admin on at /admin. At least 12 characters; shorter or missing and the admin does not exist.
ADMIN_PASSWORD=
# Optional: signs the admin login cookie (defaults to the password).
SESSION_SECRET=
# Optional: where uploaded images are kept (default data/uploads).
UPLOAD_DIR=
# The message form (opened by any email link). SMTP for Gmail: smtp.gmail.com, 465, your address and an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: where messages go (default: the email in Site settings) and the sender (default: SMTP_USER).
MAIL_TO=
MAIL_FROM=
# Set to 1 to print messages in the server log instead of sending them, for local work.
MAIL_DRY_RUN=
